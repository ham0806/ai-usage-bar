#!/bin/sh
# Optional pre-push hook: run the test suite before pushing.
# Enable with: git config core.hooksPath .githooks
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File ./test.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./test.ps1
else
    echo "pre-push: PowerShell not found; skipping tests" >&2
    exit 0
fi
