<UserControl x:Class="AiUsageBar.Shell.BarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Cursor="Hand"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border x:Name="HoverBorder" CornerRadius="6" Background="Transparent" Padding="8,0">
        <StackPanel x:Name="Row" Orientation="Horizontal" VerticalAlignment="Center" />
    </Border>
</UserControl>
