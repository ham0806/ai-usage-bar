<Window x:Class="AiUsageBar.Shell.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Bar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="#2c2c2c"
        MinWidth="304"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <StackPanel x:Name="Body" Margin="16,14" />
</Window>
