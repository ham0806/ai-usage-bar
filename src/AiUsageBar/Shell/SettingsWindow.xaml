<Window x:Class="AiUsageBar.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Bar"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Segoe UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="設定" FontSize="16" FontWeight="Bold" />
        <TextBlock x:Name="SubtitleText" Text="表示と更新の動作" Margin="0,0,0,12" />

        <GroupBox x:Name="GeneralBox" Padding="12" Margin="0,0,0,12">
            <GroupBox.Header>
                <TextBlock x:Name="GeneralHeader" Text="一般" />
            </GroupBox.Header>
            <StackPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="RefreshLabel" Text="更新間隔（秒）" VerticalAlignment="Center" />
                    <TextBox x:Name="RefreshBox" Width="80" HorizontalAlignment="Right" />
                </DockPanel>
                <CheckBox x:Name="ShowCursorBox" Content="Cursor を表示" Margin="0,4" />
                <CheckBox x:Name="ShowCodexBox" Content="Codex を表示" Margin="0,4" />
                <CheckBox x:Name="StartupBox" Content="Windows 起動時に開始" Margin="0,4" />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="PositionBox" Padding="12" Margin="0,0,0,12">
            <GroupBox.Header>
                <TextBlock x:Name="PositionHeader" Text="位置" />
            </GroupBox.Header>
            <StackPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="OffsetXLabel" Text="オフセット X" VerticalAlignment="Center" />
                    <TextBox x:Name="OffsetXBox" Width="80" HorizontalAlignment="Right" />
                </DockPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="OffsetYLabel" Text="オフセット Y" VerticalAlignment="Center" />
                    <TextBox x:Name="OffsetYBox" Width="80" HorizontalAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="AuthBox" Padding="12" Margin="0,0,0,12">
            <GroupBox.Header>
                <TextBlock x:Name="AuthHeader" Text="Cursor 認証" />
            </GroupBox.Header>
            <StackPanel>
                <TextBlock x:Name="TokenLabel" Text="セッショントークン（任意）" />
                <PasswordBox x:Name="TokenBox" Margin="0,4,0,6" />
                <TextBlock x:Name="TokenHint"
                           TextWrapping="Wrap"
                           Text="cursor.com の Cookie「WorkosCursorSessionToken」を貼り付けます。ローカルの Cursor から取れる場合は空で構いません。" />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="CodexBox" Padding="12" Margin="0,0,0,16">
            <GroupBox.Header>
                <TextBlock x:Name="CodexHeader" Text="Codex 認証" />
            </GroupBox.Header>
            <StackPanel>
                <TextBlock x:Name="CodexHint"
                           TextWrapping="Wrap"
                           Text="普段使っている codex login の auth.json を使います。期限切れのときは下のボタンからログインし直してください。" />
                <Button x:Name="CodexLoginButton" Content="codex login を開く" Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Left" Click="LoginCodex" />
            </StackPanel>
        </GroupBox>

        <DockPanel>
            <Button x:Name="ClearButton" Content="保存したトークンを削除" HorizontalAlignment="Left" Padding="12,6" Click="ClearToken" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="キャンセル" Padding="12,6" Margin="0,0,8,0" Click="Cancel" />
                <Button x:Name="SaveButton" Content="保存" Padding="16,6" Click="Save" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
