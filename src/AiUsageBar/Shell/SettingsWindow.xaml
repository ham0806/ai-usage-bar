<Window x:Class="AiUsageBar.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Bar"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Yu Gothic UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Settings" FontSize="16" FontWeight="Bold" />
        <TextBlock x:Name="SubtitleText" Text="Display and refresh" Margin="0,0,0,12" />

        <GroupBox x:Name="GeneralBox" Padding="12" Margin="0,0,0,12">
            <GroupBox.Header>
                <TextBlock x:Name="GeneralHeader" Text="General" />
            </GroupBox.Header>
            <StackPanel>
                <TextBlock x:Name="LanguageLabel" Text="Language" Margin="0,4,0,2" />
                <RadioButton x:Name="LanguageSystemRadio" GroupName="Language" Margin="0,4" />
                <RadioButton x:Name="LanguageEnglishRadio" GroupName="Language" Margin="0,4" />
                <RadioButton x:Name="LanguageJapaneseRadio" GroupName="Language" Margin="0,4" />
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="RefreshLabel" Text="Refresh interval (seconds)" VerticalAlignment="Center" />
                    <TextBox x:Name="RefreshBox" Width="80" HorizontalAlignment="Right" />
                </DockPanel>
                <CheckBox x:Name="ShowCursorBox" Content="Show Cursor" Margin="0,4" />
                <CheckBox x:Name="ShowCodexBox" Content="Show Codex" Margin="0,4" />
                <CheckBox x:Name="StartupBox" Content="Start with Windows" Margin="0,4" />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="PositionBox" Padding="12" Margin="0,0,0,12">
            <GroupBox.Header>
                <TextBlock x:Name="PositionHeader" Text="Position" />
            </GroupBox.Header>
            <StackPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="OffsetXLabel" Text="Offset X" VerticalAlignment="Center" />
                    <TextBox x:Name="OffsetXBox" Width="80" HorizontalAlignment="Right" />
                </DockPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="OffsetYLabel" Text="Offset Y" VerticalAlignment="Center" />
                    <TextBox x:Name="OffsetYBox" Width="80" HorizontalAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="AuthBox" Padding="12" Margin="0,0,0,12">
            <GroupBox.Header>
                <TextBlock x:Name="AuthHeader" Text="Cursor sign-in" />
            </GroupBox.Header>
            <StackPanel>
                <TextBlock x:Name="TokenLabel" Text="Session token (optional)" />
                <PasswordBox x:Name="TokenBox" Margin="0,4,0,6" />
                <TextBlock x:Name="TokenHint"
                           TextWrapping="Wrap"
                           Text="Paste the cursor.com cookie WorkosCursorSessionToken. Leave empty if the local Cursor app can supply it." />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="CodexBox" Padding="12" Margin="0,0,0,16">
            <GroupBox.Header>
                <TextBlock x:Name="CodexHeader" Text="Codex sign-in" />
            </GroupBox.Header>
            <StackPanel>
                <TextBlock x:Name="CodexHint"
                           TextWrapping="Wrap"
                           Text="Uses the auth.json from your usual codex login. If it expires, sign in again with the button below." />
                <Button x:Name="CodexLoginButton" Content="Open codex login" Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Left" Click="LoginCodex" />
            </StackPanel>
        </GroupBox>

        <DockPanel>
            <Button x:Name="ClearButton" Content="Remove saved token" HorizontalAlignment="Left" Padding="12,6" Click="ClearToken" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Padding="12,6" Margin="0,0,8,0" Click="Cancel" />
                <Button x:Name="SaveButton" Content="Save" Padding="16,6" Click="Save" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
